{
  "name": "lyra",
  "description": "Bilingual lyrics overlay for Spotify Web Player",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "wxt --port 5173",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:manifest": "node tools/check-manifest.mjs",
    "check:bundle": "node tools/check-bundle-budget.mjs",
    "audit:high": "npm audit --audit-level=high",
    "validate": "npm run format:check && npm run lint && npm run compile && npm test && npm run test:coverage && npm run build && npm run check:manifest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  }
}
